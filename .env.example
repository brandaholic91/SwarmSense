# Az éles docker-compose.yml változói. Dokployon az Environment fülre kerülnek.

# Kötelező
# A jelszó az adatbázis URL-jébe kerül: csak betű és szám legyen benne.
POSTGRES_PASSWORD=
# Közös titok a frontend és a backend között.
INTERNAL_SECRET=
# Az IP-lenyomat (HMAC) kulcsa.
IP_HASH_SECRET=
LLM_API_KEY=
# A nyilvános cím, a levélben és a Discord-értesítésben lévő linkekhez.
PUBLIC_BASE_URL=https://example.com

# Nem kötelező: nélkülük a levélküldés, illetve a hibajelzés nem működik.
RESEND_API_KEY=
EMAIL_FROM=
DISCORD_WEBHOOK_URL=
# Az adatkezelési és a feltételek oldalon megjelenő cím.
CONTACT_EMAIL=

# Keretek (az itt látható érték az alapértelmezés)
MAX_CONCURRENT_RUNS=2
RUNS_PER_IP_PER_DAY=3
RUNS_PER_DAY=20
EMAILS_PER_RUN=3
EMAILS_PER_DAY=30
